{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[$(date -Iseconds)] session_start\" >> $CODEX_HOME/hook.log"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import sys,json,os; d=json.load(sys.stdin); open(os.environ['CODEX_HOME']+'/hook.log','a').write('['+__import__('datetime').datetime.now().isoformat()+'] pre_tool_use tool='+d.get('tool_name','')+' cmd='+str(d.get('tool_input',{}).get('command',''))[:60]+'\\n')\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import sys,json,os; d=json.load(sys.stdin); open(os.environ['CODEX_HOME']+'/hook.log','a').write('['+__import__('datetime').datetime.now().isoformat()+'] post_tool_use tool='+d.get('tool_name','')+'\\n')\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[$(date -Iseconds)] user_prompt_submit\" >> $CODEX_HOME/hook.log"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[$(date -Iseconds)] stop\" >> $CODEX_HOME/hook.log"
          }
        ]
      }
    ]
  }
}
