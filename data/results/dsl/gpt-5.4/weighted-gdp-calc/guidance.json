{
  "skill": "weighted-gdp-calc",
  "steps": [
    {
      "stepId": "choose_tool",
      "description": "Choose tool: pandas for data analysis, openpyxl for formulas",
      "depends_on": [],
      "constraints": [
        { "tool": "openpyxl" },
        { "tool": "pandas" }
      ],
      "logical_actions": [
        {
          "actionId": 1,
          "patterns": [
            { "tool": "Write", "input_match": { "content": "import pandas|import openpyxl" } }
          ]
        }
      ]
    },
    {
      "stepId": "inspect_data_structure",
      "description": "Inspect the Data sheet to understand row layout, series codes, and year columns",
      "depends_on": ["choose_tool"],
      "constraints": [],
      "logical_actions": [
        {
          "actionId": 1,
          "patterns": [
            { "tool": "Bash", "command_match": "pd\\.read_excel|load_workbook" }
          ]
        }
      ],
      "on_enter": {
        "suggestions": [
          "Print the Data sheet rows to identify exact row numbers for each series (Exports, Imports, GDP) and year columns."
        ]
      }
    },
    {
      "stepId": "load_or_create",
      "description": "Load the existing workbook for modification",
      "depends_on": ["inspect_data_structure"],
      "constraints": [],
      "logical_actions": [
        {
          "actionId": 1,
          "patterns": [
            { "tool": "Write", "input_match": { "content": "load_workbook|Workbook\\(" } }
          ]
        }
      ]
    },
    {
      "stepId": "modify_content",
      "description": "Write INDEX/MATCH formulas with verified row ranges for all data blocks",
      "depends_on": ["load_or_create"],
      "constraints": [],
      "logical_actions": [
        {
          "actionId": 1,
          "patterns": [
            { "tool": "Write", "input_match": { "content": "INDEX.*MATCH|ws\\[|\\.cell\\(|=['\"]=" } }
          ]
        }
      ],
      "on_enter": {
        "suggestions": [
          "Verify ranges match actual Data sheet structure by checking sample values before writing all formulas."
        ]
      }
    },
    {
      "stepId": "save_workbook",
      "description": "Save the workbook",
      "depends_on": ["modify_content"],
      "constraints": [],
      "logical_actions": [
        {
          "actionId": 1,
          "patterns": [
            { "tool": "Write", "input_match": { "content": "\\.save\\(|wb\\.save" } }
          ]
        }
      ]
    },
    {
      "stepId": "recalculate_formulas",
      "description": "Recalculate formulas using recalc.py",
      "depends_on": ["save_workbook"],
      "constraints": [],
      "logical_actions": [
        {
          "actionId": 1,
          "patterns": [
            { "tool": "Bash", "command_match": "recalc\\.py|python.*recalc" }
          ]
        }
      ]
    }
  ],
  "termination": ["save_workbook", "recalculate_formulas"]
}
