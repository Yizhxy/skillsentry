{
  "skill": "protein-expression-analysis",
  "steps": [
    {
      "stepId": "choose_tool",
      "description": "Choose appropriate tool: pandas for data inspection, openpyxl for formulas/formatting",
      "depends_on": [],
      "constraints": [
        { "tool": "openpyxl" }
      ],
      "logical_actions": [
        {
          "actionId": 1,
          "patterns": [
            { "tool": "Bash", "command_match": "openpyxl|load_workbook|pandas|pd\\.read_excel" },
            { "tool": "Write", "input_match": { "content": "import openpyxl|import pandas|from openpyxl|from pandas" } }
          ]
        }
      ]
    },
    {
      "stepId": "load_workbook",
      "description": "Load existing workbook and inspect all sheets",
      "depends_on": ["choose_tool"],
      "constraints": [],
      "logical_actions": [
        {
          "actionId": 1,
          "patterns": [
            { "tool": "Bash", "command_match": "openpyxl\\.load_workbook|load_workbook|pd\\.read_excel" },
            { "tool": "Write", "input_match": { "content": "load_workbook|pd\\.read_excel|Workbook\\(" } }
          ]
        }
      ],
      "failure_patterns": [
        {
          "tool": "Write",
          "input_match": { "content": "data_only\\s*=\\s*True" },
          "reason": "⚠️ Never save a workbook loaded with data_only=True — all formulas will be permanently replaced with their last cached values."
        }
      ]
    },
    {
      "stepId": "modify_workbook",
      "description": "Modify workbook — add formulas for lookups and statistics",
      "depends_on": ["load_workbook"],
      "constraints": [],
      "logical_actions": [
        {
          "actionId": 1,
          "patterns": [
            { "tool": "Bash", "command_match": "ws\\[|sheet\\[|\\.cell\\(|append\\(" },
            { "tool": "Write", "input_match": { "content": "ws\\[|sheet\\[|\\.cell\\(|=['\"]=" } }
          ]
        }
      ],
      "on_enter": {
        "suggestions": [
          "Use Excel formulas (=INDEX/MATCH, =AVERAGE, etc.) rather than computing values in Python."
        ]
      }
    },
    {
      "stepId": "save_workbook",
      "description": "Save workbook to file",
      "depends_on": ["modify_workbook"],
      "constraints": [],
      "logical_actions": [
        {
          "actionId": 1,
          "patterns": [
            { "tool": "Bash", "command_match": "\\.save\\(|wb\\.save|to_excel\\(" },
            { "tool": "Write", "input_match": { "content": "\\.save\\(|wb\\.save|to_excel\\(" } }
          ]
        }
      ]
    },
    {
      "stepId": "recalculate_formulas",
      "description": "Recalculate formulas using recalc.py (mandatory when formulas are used)",
      "depends_on": ["save_workbook"],
      "constraints": [],
      "logical_actions": [
        {
          "actionId": 1,
          "patterns": [
            { "tool": "Bash", "command_match": "recalc\\.py|python.*recalc" }
          ]
        }
      ]
    },
    {
      "stepId": "verify_output",
      "description": "Verify recalc output — fix formula errors (#REF!, #DIV/0!, #VALUE!) and re-run until success",
      "depends_on": ["recalculate_formulas"],
      "constraints": [],
      "logical_actions": [],
      "on_enter": {
        "suggestions": [
          "Check recalc.py JSON output: if 'status' is 'errors_found', fix the listed errors and recalculate again."
        ],
        "warnings": [
          "Do not finish without confirming 'status: success' and 'total_errors: 0' in the recalc output."
        ]
      }
    }
  ],
  "termination": ["save_workbook", "recalculate_formulas"]
}
